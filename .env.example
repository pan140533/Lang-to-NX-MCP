# ═══════════════════════════════════════════════════════════════
#  NX_ROOT —— 必填，手动改
#
#  程序不会自动搜索磁盘去找 NX。请把下面这行改成你自己机器上的
#  NX 安装目录（该目录下必须存在 NXBIN\run_journal.exe）。
#  注意：填 NX 安装目录本身，不要带 \NXBIN。
#
#  示例：
#    NX_ROOT=C:\Program Files\Siemens\NX 2412
#    NX_ROOT=E:\NX\NX
#
#  留空 = 所有建模指令都会失败（找不到 run_journal.exe）。
# ═══════════════════════════════════════════════════════════════
NX_ROOT=

# ── NX 运行细节（一般不用改）───────────────────────────────────
# 单次 NX 执行超时（秒），NX 启动较慢，默认 300。
NX_TIMEOUT_SECONDS=300

# 许可证配置。MCP 客户端启动本服务时不会继承你的完整环境变量，
# 留空时会自动探测 C:\ProgramData\Siemens\siemens_SSQ.dat；
# 如果你的许可证是服务器形式（如 28000@license-server），在这里显式填写。
SPLM_LICENSE_SERVER=

# 界面语言（可选），例如 simpl_chinese
UGII_LANG=

# ── LLM 配置（可选）───────────────────────────────────────────
# 当前版本的步骤规划由规则引擎完成，不填也能建模。
# 兼容任何 OpenAI 协议的服务，默认 DeepSeek。
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7

# ── 目录（可选）───────────────────────────────────────────────
# OUTPUT_DIR 是输出根目录，.prt 文件实际落在 OUTPUT_DIR/models/ 下。
OUTPUT_DIR=output
SESSION_DIR=sessions
